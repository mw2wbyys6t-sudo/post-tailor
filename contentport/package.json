{
  "name": "omnidraft",
  "productName": "OmniDraft",
  "version": "1.5.0",
  "description": "一稿千面：把一篇文章改写成各平台原生版本，分发并回拉数据",
  "main": "electron/main.js",
  "author": "OmniDraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mw2wbyys6t-sudo/post-tailor.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage",
    "test": "node --test",
    "eval": "node eval/run.js",
    "eval:ai": "node eval/run.js --ai",
    "eval:baseline": "node eval/run.js --engine=both --save-baseline",
    "eval:calibrate": "node eval/calibrate.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.omnidraft.app",
    "productName": "OmniDraft 一稿千面",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "styles.css",
      "js/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mw2wbyys6t-sudo",
        "repo": "post-tailor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OmniDraft-Win-x64-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OmniDraft-Linux-x64-${version}.${ext}",
      "category": "Office"
    }
  }
}
