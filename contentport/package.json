{
  "name": "omnidraft",
  "productName": "OmniDraft",
  "version": "1.4.2",
  "description": "一稿千面：把一篇文章改写成各平台原生版本，分发并回拉数据",
  "main": "electron/main.js",
  "author": "OmniDraft",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mw2wbyys6t-sudo/post-tailor.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test": "node --test",
    "eval": "node eval/run.js",
    "eval:ai": "node eval/run.js --ai",
    "eval:baseline": "node eval/run.js --engine=both --save-baseline",
    "eval:calibrate": "node eval/calibrate.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.omnidraft.app",
    "productName": "OmniDraft 一稿千面",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "styles.css",
      "js/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OmniDraft-Win-x64-${version}.zip",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OmniDraft-Linux-x64-${version}.zip",
      "category": "Office"
    }
  }
}
